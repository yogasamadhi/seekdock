+/** Agent-backend domain zod schemas. */
+
+import { z } from 'zod'
+import type { RequestPayload, ResponseValue } from './rpc-map.ts'
+import type { Wire } from './rpc.schema.ts'
+import { agentBackendIdSchema, sessionIdSchema } from './sessions.schema.ts'
+import type { AgentBackendEntry } from './agent-backends.ts'
+
+/** One row of agentBackend.list. */
+export const agentBackendEntrySchema = z.object({
+  id: agentBackendIdSchema,
+  name: z.string().min(1),
+  description: z.string().optional(),
+  isDefault: z.boolean(),
+}) satisfies z.ZodType<Wire<AgentBackendEntry>>
+
+/** agentBackend.list request payload. */
+export const agentBackendListRequestSchema = z.object({
+}) satisfies z.ZodType<Wire<RequestPayload<'agentBackend.list'>>>
+
+/** agentBackend.list response value. */
+export const agentBackendListValueSchema = z.object({
+  backends: z.array(agentBackendEntrySchema),
+}) satisfies z.ZodType<Wire<ResponseValue<'agentBackend.list'>>>
+
+/** agentBackend.select request payload. */
+export const agentBackendSelectRequestSchema = z.object({
+  sessionId: sessionIdSchema,
+  agentBackend: agentBackendIdSchema,
+}) satisfies z.ZodType<Wire<RequestPayload<'agentBackend.select'>>>
+
+/** agentBackend.select response value. */
+export const agentBackendSelectValueSchema = z.object({
+  agentBackend: agentBackendIdSchema,
+}) satisfies z.ZodType<Wire<ResponseValue<'agentBackend.select'>>>
