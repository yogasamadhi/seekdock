diff --git a/packages/host/apiproxy/tests/api-proxy-agent-backend.spec.ts b/packages/host/apiproxy/tests/api-proxy-agent-backend.spec.ts
new file mode 100644
index 0000000000..7eed916c5c
--- /dev/null
+++ b/packages/host/apiproxy/tests/api-proxy-agent-backend.spec.ts
@@ -0,0 +1,123 @@
+import { Context } from '@deepseek-ai/cordis'
+import AgentRegistry from '@deepseek-ai/dsh-agent'
+import AgentLoop, {
+  DSH_AGENT_BACKEND_ID,
+  type AgentBackendDriver,
+} from '@deepseek-ai/dsh-agent-loop'
+import LlmRuntime from '@deepseek-ai/dsh-llm'
+import SessionStore, { AgentBackendId, SessionId } from '@deepseek-ai/dsh-session'
+import SystemPrompt from '@deepseek-ai/dsh-system-prompt'
+import ToolRuntime from '@deepseek-ai/dsh-tools'
+import UserQuestionService from '@deepseek-ai/dsh-user-questions'
+import { describe, expect, it } from 'vitest'
+import { createApiProxy } from '../src/api-proxy.ts'
+import { RpcId, type RpcRequest } from '../src/api/rpc.ts'
+
+const PI_BACKEND = AgentBackendId('pi')
+let nextRpc = 0
+
+function request<P>(payload: P): RpcRequest<P> {
+  return { rpcId: RpcId(`backend-${String(nextRpc++)}`), payload }
+}
+
+async function harness() {
+  const ctx = new Context()
+  await ctx.plugin(LlmRuntime)
+  await ctx.plugin(SessionStore)
+  await ctx.plugin(SystemPrompt)
+  await ctx.plugin(ToolRuntime)
+  await ctx.plugin(AgentRegistry)
+  await ctx.plugin(AgentLoop, { agents: [] })
+  await ctx.plugin(UserQuestionService)
+  const pi: AgentBackendDriver = {
+    id: PI_BACKEND,
+    name: 'Pi',
+    description: 'Pi agent-core loop',
+    runStep: () => Promise.resolve({ kind: 'completed' }),
+  }
+  ctx.effect(() => ctx.agentLoop.registerBackend(pi), 'test.piBackend()')
+  const api = createApiProxy(ctx, {
+    defaultModelSelection: () => ({ provider: 'test', model: 'test-model' }),
+    cwd: '/tmp',
+  })
+  return { api, ctx }
+}
+
+describe('agentBackend API', () => {
+  it('lists the built-in and contributed backends and marks the default', async () => {
+    const { api, ctx } = await harness()
+
+    const response = await api.agentBackends.list(request({}))
+
+    expect(response.result).toEqual({
+      ok: true,
+      value: {
+        backends: [
+          expect.objectContaining({ id: DSH_AGENT_BACKEND_ID, isDefault: true }),
+          expect.objectContaining({ id: PI_BACKEND, name: 'Pi', isDefault: false }),
+        ],
+      },
+    })
+    await ctx.fiber.dispose()
+  })
+
+  it('creates with an explicit backend and reports it in the Session summary', async () => {
+    const { api, ctx } = await harness()
+
+    const created = await api.sessions.create(request({
+      sessionId: SessionId('pi-session'),
+      agentBackend: PI_BACKEND,
+    }))
+    const listed = await api.sessions.list(request({}))
+
+    expect(created.result).toMatchObject({ ok: true, value: { agentBackend: PI_BACKEND } })
+    expect(ctx.agents.get(SessionId('pi-session'))?.backend).toBe(PI_BACKEND)
+    expect(listed.result).toMatchObject({
+      ok: true,
+      value: { items: [expect.objectContaining({ agentBackend: PI_BACKEND })] },
+    })
+    await ctx.fiber.dispose()
+  })
+
+  it('switches a blank Session durably, then locks it after the first turn', async () => {
+    const { api, ctx } = await harness()
+    await api.sessions.create(request({ sessionId: SessionId('switch-session') }))
+
+    const selected = await api.agentBackends.select(request({
+      sessionId: SessionId('switch-session'),
+      agentBackend: PI_BACKEND,
+    }))
+    const session = ctx.sessions.get(SessionId('switch-session'))
+    session?.append('turn/start', { turn: 1 })
+    const locked = await api.agentBackends.select(request({
+      sessionId: SessionId('switch-session'),
+      agentBackend: DSH_AGENT_BACKEND_ID,
+    }))
+
+    expect(selected.result).toEqual({ ok: true, value: { agentBackend: PI_BACKEND } })
+    expect(session?.events.findLast(event => event.type === 'agent/backend-selected'))
+      .toMatchObject({ data: { agentBackend: PI_BACKEND } })
+    expect(locked.result).toMatchObject({ ok: false, error: { code: 'agent-backend-locked' } })
+    await ctx.fiber.dispose()
+  })
+
+  it('returns a stable not-found error without changing the Session', async () => {
+    const { api, ctx } = await harness()
+    await api.sessions.create(request({ sessionId: SessionId('unknown-session') }))
+
+    const response = await api.agentBackends.select(request({
+      sessionId: SessionId('unknown-session'),
+      agentBackend: AgentBackendId('missing'),
+    }))
+
+    expect(response.result).toMatchObject({
+      ok: false,
+      error: {
+        code: 'agent-backend-not-found',
+        details: { agentBackend: 'missing', available: [DSH_AGENT_BACKEND_ID, PI_BACKEND] },
+      },
+    })
+    expect(ctx.agents.get(SessionId('unknown-session'))?.backend).toBe(DSH_AGENT_BACKEND_ID)
+    await ctx.fiber.dispose()
+  })
+})
