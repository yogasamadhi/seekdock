diff --git a/packages/core/agent-loop/src/backend.ts b/packages/core/agent-loop/src/backend.ts
new file mode 100644
index 0000000000..3a850209ce
--- /dev/null
+++ b/packages/core/agent-loop/src/backend.ts
@@ -0,0 +1,76 @@
+import type { Agent, RequestErrorAction } from '@deepseek-ai/dsh-agent'
+import type {
+  AssistantMessage,
+  GenerateOptions,
+  LlmFailure,
+  PreparedLlmCall,
+  ResolvedRetryPolicy,
+  StreamChunk,
+  TokenUsage,
+} from '@deepseek-ai/dsh-llm'
+import type { AgentBackendId, Session, SessionId, TurnEndReason } from '@deepseek-ai/dsh-session'
+import type { PromptAssembly } from '@deepseek-ai/dsh-system-prompt'
+import type { Context } from '@deepseek-ai/cordis'
+
+/** Human-facing metadata for one registered Agent backend. */
+export interface AgentBackendInfo {
+  /** Stable backend id persisted in session history. */
+  readonly id: AgentBackendId
+  /** Short user-facing backend name. */
+  readonly name: string
+  /** Optional user-facing explanation of the loop implementation. */
+  readonly description?: string
+}
+
+/** A completed model step outcome understood by the DSH turn owner. */
+export type AgentBackendStepEnd = Extract<TurnEndReason, { kind: 'completed' | 'max-tokens' }> | null
+
+/** DSH-owned operations exposed to one backend while it drives a model step. */
+export interface AgentBackendStepContext {
+  readonly agent: Agent
+  readonly ctx: Context
+  readonly session: Session
+  readonly assembly: PromptAssembly
+  readonly turn: number
+  readonly step: number
+  readonly signal: AbortSignal
+
+  /** Build the next DSH request from the authoritative session log. */
+  buildRequest(): Promise<{ request: GenerateOptions; preparedCall?: PreparedLlmCall }>
+  /** Append one provider stream chunk and return its durable sequence. */
+  appendChunk(chunk: StreamChunk): number
+  /** Append the final assistant message produced from the recorded chunks. */
+  appendAssistant(message: AssistantMessage, sourceEventSeqs: number[], usage?: TokenUsage, interrupted?: boolean): void
+  /** Ask DSH request-recovery middleware whether one failed attempt should retry. */
+  requestError(provider: string, failure: LlmFailure, retryPolicy: ResolvedRetryPolicy | undefined): Promise<RequestErrorAction>
+  /** Execute one assistant tool-call batch through DSH approval, sandbox, and scheduling. */
+  executeToolCalls(message: AssistantMessage): Promise<{ concluded: boolean }>
+}
+
+/** One effect-scoped implementation of the per-step Agent loop. */
+export interface AgentBackendDriver extends AgentBackendInfo {
+  /**
+   * Drive one DSH step. The DSH runtime owns turns, inboxes, cancellation,
+   * session logging, and actual tool execution around this operation.
+   */
+  runStep(context: AgentBackendStepContext): Promise<AgentBackendStepEnd>
+}
+
+/** Requested Agent backend is not registered in this deployment. */
+export class UnknownAgentBackendError extends Error {
+  constructor(
+    readonly backend: AgentBackendId,
+    readonly available: readonly AgentBackendId[],
+  ) {
+    super(`agent backend "${backend}" is not registered; available: ${available.join(', ')}`)
+    this.name = 'UnknownAgentBackendError'
+  }
+}
+
+/** A Session has started its first turn and can no longer change backend. */
+export class AgentBackendLockedError extends Error {
+  constructor(readonly sessionId: SessionId, readonly backend: AgentBackendId) {
+    super(`session "${sessionId}" has already started; its agent backend is fixed`)
+    this.name = 'AgentBackendLockedError'
+  }
+}
diff --git a/packages/core/agent-loop/src/dsh-backend.ts b/packages/core/agent-loop/src/dsh-backend.ts
new file mode 100644
index 0000000000..35d99e9dc7
--- /dev/null
+++ b/packages/core/agent-loop/src/dsh-backend.ts
@@ -0,0 +1,70 @@
+import type { AgentBackendDriver, AgentBackendStepContext, AgentBackendStepEnd } from './backend.ts'
+import { AgentBackendId } from '@deepseek-ai/dsh-session'
+import { BlockAssembler, LlmError, createAssistantMessage } from '@deepseek-ai/dsh-llm'
+
+/** Stable id of the built-in DeepSeek Harness loop. */
+export const DSH_AGENT_BACKEND_ID = AgentBackendId('dsh')
+
+/** Drive one model/tool step with the built-in DSH reaction loop. */
+async function runDshAgentStep(context: AgentBackendStepContext): Promise<AgentBackendStepEnd> {
+  const { signal } = context
+  while (true) {
+    const { request, preparedCall } = await context.buildRequest()
+    const assembler = new BlockAssembler()
+    const chunkSeqs: number[] = []
+    try {
+      const stream = preparedCall?.stream(request) ?? context.ctx.llm.stream(request)
+      signal.throwIfAborted()
+      for await (const chunk of stream) {
+        signal.throwIfAborted()
+        chunkSeqs.push(context.appendChunk(chunk))
+        assembler.push(chunk)
+      }
+      signal.throwIfAborted()
+    } catch (error: unknown) {
+      if (signal.aborted) {
+        const content = assembler.interruptedBlocks()
+        if (content.length > 0) {
+          context.appendAssistant(createAssistantMessage({
+            content,
+            source: { provider: request.provider, model: request.model },
+          }), chunkSeqs, assembler.usage, true)
+        }
+      }
+      throw error
+    }
+    const finish = assembler.finish
+    if (finish.kind === 'error' || finish.kind === 'aborted') {
+      const action = await context.requestError(request.provider, finish.failure, preparedCall?.retryPolicy)
+      signal.throwIfAborted()
+      if (action?.kind !== 'retry') {
+        throw new LlmError(finish.failure.message, finish.failure.code, finish.failure)
+      }
+      continue
+    }
+
+    const message = createAssistantMessage({
+      content: assembler.blocks(),
+      source: {
+        provider: request.provider,
+        model: request.model,
+        ...assembler.replayState !== undefined ? { replayState: assembler.replayState } : {},
+      },
+    })
+    context.appendAssistant(message, chunkSeqs, assembler.usage)
+    if (finish.kind === 'max-tokens') return { kind: 'max-tokens' }
+
+    const toolCalls = message.content.filter(block => block.type === 'tool-call')
+    if (toolCalls.length === 0) return { kind: 'completed' }
+    const { concluded } = await context.executeToolCalls(message)
+    return concluded ? { kind: 'completed' } : null
+  }
+}
+
+/** Built-in backend contribution. */
+export const dshAgentBackend: AgentBackendDriver = {
+  id: DSH_AGENT_BACKEND_ID,
+  name: 'DeepSeek Harness',
+  description: 'The built-in DSH reaction loop.',
+  runStep: runDshAgentStep,
+}
