index 0000000000..7eca36e89b
--- /dev/null
+++ b/packages/host/apiproxy/src/api/agent-backends.ts
@@ -0,0 +1,30 @@
+/** Agent-backend roster and blank-session selection contract. */
+
+import type { AgentBackendId, SessionId } from '@deepseek-ai/dsh-session/types'
+import type { RpcRequest, RpcResponse } from './rpc.ts'
+
+/** One Agent loop backend registered in this deployment. */
+export interface AgentBackendEntry {
+  /** Stable id persisted with a Session. */
+  readonly id: AgentBackendId
+  /** Short user-facing name. */
+  readonly name: string
+  /** Optional explanation of the loop implementation. */
+  readonly description?: string
+  /** Whether an unnamed new Session selects this backend. */
+  readonly isDefault: boolean
+}
+
+/** Agent-backend-domain unary methods (the map key agentBackend.* of RpcMethodMap). */
+export interface AgentBackendsApi {
+  /** List the registered Agent loop backends in deployment registration order. */
+  list(request: RpcRequest<{}>): Promise<RpcResponse<{ backends: readonly AgentBackendEntry[] }>>
+
+  /**
+   * Select the backend for one live blank Session. Once its first turn starts,
+   * the durable conversation is bound to that backend and selection answers
+   * `agent-backend-locked`.
+   */
+  select(request: RpcRequest<{ sessionId: SessionId; agentBackend: AgentBackendId }>):
+  Promise<RpcResponse<{ agentBackend: AgentBackendId }>>
+}
