diff --git a/packages/core/agent-loop/src/session.ts b/packages/core/agent-loop/src/session.ts
new file mode 100644
index 0000000000..f16d58faa3
--- /dev/null
+++ b/packages/core/agent-loop/src/session.ts
@@ -0,0 +1,30 @@
+import { AgentBackendId } from '@deepseek-ai/dsh-session'
+import type { SessionEvent, SessionHeader } from '@deepseek-ai/dsh-session'
+import { DSH_AGENT_BACKEND_ID } from './dsh-backend.ts'
+
+declare module '@deepseek-ai/dsh-session/types' {
+  interface SessionEventMap {
+    /** Agent backend selected while the session was still blank. */
+    'agent/backend-selected': { agentBackend: AgentBackendId }
+  }
+}
+
+/** The minimum durable state needed to resolve a session's backend. */
+export interface BackendBearingSession {
+  readonly header: SessionHeader
+  readonly events: readonly SessionEvent[]
+}
+
+/**
+ * Resolve the backend that must drive a session, with the latest logged blank
+ * selection winning over its creation header and legacy logs using DSH.
+ * @param session - durable header and event history.
+ * @returns the selected backend id.
+ */
+export function resolveSessionBackend(session: BackendBearingSession): AgentBackendId {
+  for (let index = session.events.length - 1; index >= 0; index -= 1) {
+    const event = session.events[index]
+    if (event?.type === 'agent/backend-selected') return event.data.agentBackend
+  }
+  return session.header.agentBackend ?? DSH_AGENT_BACKEND_ID
+}
