diff --git a/packages/core/agent-loop/tests/backend.spec.ts b/packages/core/agent-loop/tests/backend.spec.ts
new file mode 100644
index 0000000000..9ec2c2479c
--- /dev/null
+++ b/packages/core/agent-loop/tests/backend.spec.ts
@@ -0,0 +1,159 @@
+import { Context } from '@deepseek-ai/cordis'
+import AgentRegistry, { Inbox, type Agent } from '@deepseek-ai/dsh-agent'
+import AgentLoop, { DSH_AGENT_BACKEND_ID, resolveSessionBackend } from '@deepseek-ai/dsh-agent-loop'
+import type { AgentBackendDriver, AgentBackendStepEnd } from '@deepseek-ai/dsh-agent-loop'
+import LlmRuntime, { createUserMessage } from '@deepseek-ai/dsh-llm'
+import SessionStore, { AgentBackendId, Session, SessionId } from '@deepseek-ai/dsh-session'
+import SystemPrompt from '@deepseek-ai/dsh-system-prompt'
+import ToolRuntime from '@deepseek-ai/dsh-tools'
+import { describe, expect, it, vi } from 'vitest'
+
+const PI_BACKEND = AgentBackendId('pi')
+
+async function boot(
+  runStep: AgentBackendDriver['runStep'] = vi.fn<AgentBackendDriver['runStep']>(
+    () => Promise.resolve({ kind: 'completed' }),
+  ),
+) {
+  const ctx = new Context()
+  await ctx.plugin(LlmRuntime)
+  await ctx.plugin(SessionStore)
+  await ctx.plugin(SystemPrompt)
+  await ctx.plugin(ToolRuntime)
+  await ctx.plugin(AgentRegistry)
+  await ctx.plugin(AgentLoop, { agents: [] })
+  const driver: AgentBackendDriver = { id: PI_BACKEND, name: 'Pi', runStep }
+  const dispose = ctx.effect(() => ctx.agentLoop.registerBackend(driver), 'test.piBackend()')
+  return { ctx, driver, dispose, runStep }
+}
+
+function prompt(text: string) {
+  return createUserMessage({ content: [{ type: 'text', text }], source: { kind: 'user' } })
+}
+
+function unmanagedAgent(rawId: string): Agent {
+  const id = SessionId(rawId)
+  const session = Session.create(id)
+  return {
+    id,
+    options: {},
+    session,
+    inbox: new Inbox(session, { inserted: () => {}, discarded: () => {}, claimed: () => {} }),
+    status: 'idle',
+    ctx: new Context(),
+    send: () => {},
+    followup: () => {},
+    steer: () => ({ outcome: Promise.resolve({ status: 'rejected' as const }) }),
+    inject: () => {},
+    cancel: () => {},
+    runMaintenance: task => task(new AbortController().signal),
+    whenIdle: () => Promise.resolve(),
+  }
+}
+
+describe('agent backend registry and selection', () => {
+  it('lists the built-in and effect-scoped contributions and removes disposed contributions', async () => {
+    const { ctx, dispose } = await boot()
+    expect(ctx.agentLoop.listBackends().map(backend => backend.id)).toEqual([DSH_AGENT_BACKEND_ID, PI_BACKEND])
+
+    await dispose()
+
+    expect(ctx.agentLoop.listBackends().map(backend => backend.id)).toEqual([DSH_AGENT_BACKEND_ID])
+    await ctx.fiber.dispose()
+  })
+
+  it('uses an explicit backend for a new session and records the initial choice', async () => {
+    const { ctx, runStep } = await boot()
+    const handle = await ctx.agents.create({ sessionId: SessionId('pi-create'), agentBackend: PI_BACKEND })
+
+    expect(handle.agent.backend).toBe(PI_BACKEND)
+    expect(handle.agent.session.header.agentBackend).toBe(PI_BACKEND)
+    expect(handle.agent.session.events[0]).toMatchObject({
+      type: 'agent/backend-selected',
+      data: { agentBackend: PI_BACKEND },
+    })
+    handle.agent.followup(prompt('run pi'))
+    await handle.agent.whenIdle()
+    expect(runStep).toHaveBeenCalledOnce()
+    await handle.dispose()
+    await ctx.fiber.dispose()
+  })
+
+  it('switches a blank session once durably and locks after the first turn starts', async () => {
+    const { ctx } = await boot()
+    const agent = ctx.agentLoop.create(SessionId('switch'))
+
+    await ctx.agentLoop.selectBackend(agent.id, PI_BACKEND)
+    expect(agent.backend).toBe(PI_BACKEND)
+    expect(resolveSessionBackend(agent.session)).toBe(PI_BACKEND)
+    expect(agent.session.events.filter(event => event.type === 'agent/backend-selected')).toHaveLength(2)
+
+    agent.followup(prompt('first'))
+    await agent.whenIdle()
+    await expect(ctx.agentLoop.selectBackend(agent.id, DSH_AGENT_BACKEND_ID))
+      .rejects.toThrow(/already started/)
+    expect(agent.backend).toBe(PI_BACKEND)
+    await ctx.fiber.dispose()
+  })
+
+  it('treats selecting the current blank backend as an idempotent no-op', async () => {
+    const { ctx } = await boot()
+    const agent = ctx.agentLoop.create(SessionId('same-backend'))
+
+    await ctx.agentLoop.selectBackend(agent.id, DSH_AGENT_BACKEND_ID)
+
+    expect(agent.session.events.filter(event => event.type === 'agent/backend-selected')).toHaveLength(1)
+    await ctx.fiber.dispose()
+  })
+
+  it('rejects a switch while the selected backend is driving a step', async () => {
+    const gate = Promise.withResolvers<AgentBackendStepEnd>()
+    const { ctx } = await boot(() => gate.promise)
+    const agent = ctx.agentLoop.create(SessionId('running-switch'), {}, {}, PI_BACKEND)
+    agent.followup(prompt('hold'))
+    await vi.waitFor(() => { expect(agent.status).toBe('running') })
+
+    expect(() => agent.runMaintenance(() => Promise.resolve())).toThrow(/already has active work/)
+    await expect(ctx.agentLoop.selectBackend(agent.id, DSH_AGENT_BACKEND_ID))
+      .rejects.toThrow(/already started/)
+
+    gate.resolve({ kind: 'completed' })
+    await agent.whenIdle()
+    await ctx.fiber.dispose()
+  })
+
+  it('rejects unknown and duplicate registrations without disturbing the registry', async () => {
+    const { ctx, driver } = await boot()
+    expect(() => ctx.agentLoop.registerBackend(driver)).toThrow(/already registered/)
+    await expect(ctx.agentLoop.selectBackend(SessionId('missing'), AgentBackendId('unknown')))
+      .rejects.toThrow(/not registered/)
+    expect(ctx.agentLoop.listBackends().map(backend => backend.id)).toEqual([DSH_AGENT_BACKEND_ID, PI_BACKEND])
+    await ctx.fiber.dispose()
+  })
+
+  it('validates ids, protects a replacement from a stale disposer, and rejects foreign agents', async () => {
+    const { ctx } = await boot()
+    expect(() => ctx.agentLoop.registerBackend({ id: AgentBackendId(''), name: 'empty', runStep: vi.fn() }))
+      .toThrow(/non-empty/)
+
+    const first: AgentBackendDriver = { id: AgentBackendId('replaceable'), name: 'first', runStep: vi.fn() }
+    const second: AgentBackendDriver = { id: first.id, name: 'second', runStep: vi.fn() }
+    const removeFirst = ctx.agentLoop.registerBackend(first)
+    removeFirst()
+    const removeSecond = ctx.agentLoop.registerBackend(second)
+    removeFirst()
+    expect(ctx.agentLoop.listBackends()).toContainEqual({ id: second.id, name: 'second' })
+    removeSecond()
+
+    const foreign = unmanagedAgent('foreign')
+    const detach = ctx.agents.enter(foreign, undefined)
+    await expect(ctx.agentLoop.selectBackend(foreign.id, PI_BACKEND))
+      .rejects.toThrow(/not managed by this agent loop/)
+    detach()
+    await expect(ctx.agents.create({
+      sessionId: SessionId('unknown-create'),
+      agentBackend: AgentBackendId('unknown'),
+    })).rejects.toThrow(/not registered/)
+    await ctx.fiber.dispose()
+  })
+})
