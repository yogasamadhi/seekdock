{
  "name": "seekdock",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "bun": "1.3.14"
  },
  "scripts": {
    "start": "bun run.ts",
    "bootstrap": "bun scripts/bootstrap.mjs",
    "vendor:build:dsh": "bun scripts/build-dsh.mjs",
    "runtime:prepare": "bun scripts/prepare-runtime.mjs",
    "dev": "bun run.ts --skip-check",
    "build": "bun run --filter @seekdock/desktop build",
    "typecheck": "bunx tsc --noEmit -p tsconfig.json && bun run --filter @seekdock/desktop typecheck",
    "lint": "bunx oxlint --deny-warnings apps scripts run.ts",
    "format:check": "bunx prettier --check .",
    "test": "bunx vitest run",
    "test:e2e": "bun run --filter @seekdock/desktop test:e2e",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test",
    "package:dir": "bun run build && bun run runtime:prepare && bun run --filter @seekdock/desktop package:dir"
  },
  "trustedDependencies": [
    "electron",
    "electron-winstaller",
    "esbuild"
  ],
  "devDependencies": {
    "@electron/get": "3.1.0",
    "@playwright/test": "1.59.1",
    "@types/node": "24.12.2",
    "electron": "42.3.3",
    "electron-builder": "26.15.2",
    "electron-vite": "5.0.0",
    "oxlint": "1.76.0",
    "prettier": "3.6.2",
    "typescript": "6.0.3",
    "vite": "7.1.4",
    "vitest": "4.1.8"
  }
}
